# ---------------------------------------------------------------------------
# Local development (copy to .env; .env is git-ignored). Never commit secrets.
# In Cloud Run, secrets come from Secret Manager (see README), not env files.
# ---------------------------------------------------------------------------

# production | local. "local" allows in-memory store/queue/token store.
APP_MODE=local
# true: print the formatted recap to stdout instead of posting to Google Chat.
DRY_RUN=true
PORT=8080
LOG_LEVEL=info
# Public HTTPS URL of the service (Cloud Run URL in production). Used for the
# OAuth redirect URI (<base>/oauth/callback) and the Cloud Tasks target.
PUBLIC_BASE_URL=http://localhost:8080

# --- Fireflies -------------------------------------------------------------
# API key: Fireflies > Integrations > Fireflies API.
FIREFLIES_API_KEY=
# Signing secret set on the Webhooks V2 page (>= 16 chars).
FIREFLIES_WEBHOOK_SECRET=replace-with-a-long-random-local-secret

# --- Google OAuth / Chat ---------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The only account allowed to connect; recaps are posted as this user.
GOOGLE_AUTHORIZED_USER_EMAIL=
# Space resource name, e.g. spaces/AAAAxxxxxxx (not the browser URL).
GOOGLE_CHAT_SPACE=
# Protects /oauth/start. Generate: openssl rand -base64 48
OAUTH_ADMIN_TOKEN=

# --- Meeting eligibility (default: nothing is posted) ---------------------
# JSON array. Within a rule all criteria must match; any rule may match.
# Criteria: organizerEmails, organizerDomains, titleContains, calendarIds, titleExcludes.
MEETING_RULES=[]
# MEETING_RULES=[{"name":"ops-sync","organizerEmails":["you@orcarehab.com"],"titleContains":["Ops Sync"]}]

# --- Google Cloud (production) --------------------------------------------
GOOGLE_CLOUD_PROJECT=
REFRESH_TOKEN_SECRET_ID=google-chat-refresh-token
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=ff_recaps_
TASKS_LOCATION=us-west1
TASKS_QUEUE=fireflies-recaps
TASKS_INVOKER_SERVICE_ACCOUNT=
# Defaults to PUBLIC_BASE_URL.
TASKS_AUDIENCE=
# Must equal the queue's --max-attempts.
TASKS_MAX_ATTEMPTS=20

# Backends are derived from APP_MODE; override only if you know why.
# STORE_BACKEND=memory        # firestore | memory
# QUEUE_BACKEND=inline        # cloudtasks | inline
# TOKEN_STORE_BACKEND=memory  # secretmanager | memory
