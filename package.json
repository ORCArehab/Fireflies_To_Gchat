{
  "name": "orca-fireflies-chat-recaps",
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "tsx --env-file-if-exists=.env src/cli/preview.ts",
    "replay": "tsx --env-file-if-exists=.env src/cli/replay.ts"
  },
  "description": "Posts Fireflies meeting recaps into a Google Chat space as an authorized ORCA Rehab user",
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/tasks": "^5.5.2",
    "fastify": "^5.12.7",
    "google-auth-library": "^9.15.1",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
